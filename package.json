{
  "name": "the-sutra-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/templeApiServer.mjs",
    "prestart": "node scripts/exportTempleStore.mjs",
    "start": "node scripts/templeApiServer.mjs --host=0.0.0.0 --port=$PORT",
    "prestart:api": "node scripts/exportTempleStore.mjs",
    "start:api": "node scripts/templeApiServer.mjs --host=0.0.0.0 --port=$PORT",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:duplicates": "node scripts/checkTempleDuplicates.mjs",
    "validate:state": "node scripts/validateTempleDataset.mjs",
    "validate:mp": "node scripts/validateTempleDataset.mjs src/data/temples/madhyaPradesh.js madhyaPradeshTemples --shiva-only",
    "add:temples": "node scripts/addTemples.mjs",
    "stamp:addedat": "node scripts/stampAddedAt.mjs",
    "images:wikimedia": "node scripts/fetchWikimediaImages.mjs",
    "store:export": "node scripts/exportTempleStore.mjs",
    "store:ingest": "node scripts/ingestTempleStore.mjs",
    "seed:state": "node scripts/exportStateSeedFromJs.mjs"
  },
  "dependencies": {
    "@ishubhamx/panchangam-js": "^2.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^8.0.0-beta.13"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
